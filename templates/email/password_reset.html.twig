{#
    Password reset link sent by another administrator. Variables: adminUser, resetUrl,
    validUntil, localeCode. Override like invitation.html.twig: extend
    '@!CalmfoxSyliusAdminInvitationPlugin/email/password_reset.html.twig' and replace blocks.
#}
{% extends '@CalmfoxSyliusAdminInvitationPlugin/email/layout.html.twig' %}

{% block subject %}
    {{ 'calmfox_admin_invitation.password_reset_email.subject'|trans({}, null, localeCode)|raw }}
{% endblock %}

{% block content %}
    {% block heading %}
        <div style="text-align: center; font-size: 24px;">{{ 'calmfox_admin_invitation.email.hello'|trans({}, null, localeCode) }}</div>
    {% endblock %}

    {% block lead %}
        <p style="text-align: center; margin: 0 0 30px 0;">{{ 'calmfox_admin_invitation.password_reset_email.lead'|trans({}, null, localeCode) }}</p>
    {% endblock %}

    {% block action %}
        <div style="text-align: center;">
            <a href="{{ resetUrl }}" style="display: inline-block; text-align: center; background: #1abb9c; padding: 18px 28px; color: #fff; text-decoration: none; border-radius: 3px;">
                {{ 'calmfox_admin_invitation.password_reset_email.action'|trans({}, null, localeCode) }}
            </a>
        </div>
    {% endblock %}

    {% block details %}
        <div style="text-align: center; margin-top: 30px; font-size: 14px; color: #777;">
            {{ 'calmfox_admin_invitation.email.login'|trans({}, null, localeCode) }}: <strong>{{ adminUser.email }}</strong><br>
            {{ 'calmfox_admin_invitation.password_reset_email.details'|trans({'%date%': validUntil|date('Y-m-d H:i')}, null, localeCode) }}
        </div>
    {% endblock %}
{% endblock %}
