{#
    Suggests a random password. It is generated in the browser with the Web Crypto API,
    so it never leaves the device until the form is submitted.
#}
{% set form = hookable_metadata.context.form %}
{% set length = hookable_metadata.context.generatedPasswordLength|default(20) %}

<div class="mb-3" data-calmfox-password-generator
     data-length="{{ length }}"
     data-first="{{ form.password.first.vars.id }}"
     data-second="{{ form.password.second.vars.id }}">
    <button type="button" class="btn w-100" data-generate>
        {{ ux_icon('tabler:wand', {class: 'icon'}) }}
        {{ 'calmfox_admin_invitation.ui.generate_password'|trans }}
    </button>

    <div class="mt-2" data-result hidden>
        <div class="input-group">
            <input type="text" class="form-control font-monospace" readonly data-value aria-label="{{ 'calmfox_admin_invitation.ui.generated_password'|trans }}">
            <button type="button" class="btn" data-copy data-copied-label="{{ 'calmfox_admin_invitation.ui.copied'|trans }}">
                {{ ux_icon('tabler:copy', {class: 'icon'}) }}
                <span data-copy-label>{{ 'calmfox_admin_invitation.ui.copy'|trans }}</span>
            </button>
        </div>
        <div class="form-hint">{{ 'calmfox_admin_invitation.ui.generated_password_hint'|trans }}</div>
    </div>
</div>

<script>
    (() => {
        const root = document.currentScript.previousElementSibling;
        const sets = ['ABCDEFGHJKLMNPQRSTUVWXYZ', 'abcdefghijkmnopqrstuvwxyz', '23456789', '!@#$%^&*-_=+?'];
        const all = sets.join('');

        // uniform index in [0, max) without modulo bias
        const randomIndex = (max) => {
            const limit = Math.floor(0x100000000 / max) * max;
            const buffer = new Uint32Array(1);
            do { crypto.getRandomValues(buffer); } while (buffer[0] >= limit);
            return buffer[0] % max;
        };

        const generate = (length) => {
            const chars = sets.map((set) => set[randomIndex(set.length)]);
            while (chars.length < length) chars.push(all[randomIndex(all.length)]);
            for (let i = chars.length - 1; i > 0; i--) {
                const j = randomIndex(i + 1);
                [chars[i], chars[j]] = [chars[j], chars[i]];
            }
            return chars.join('');
        };

        const first = document.getElementById(root.dataset.first);
        const second = document.getElementById(root.dataset.second);
        const result = root.querySelector('[data-result]');
        const value = root.querySelector('[data-value]');
        const copyLabel = root.querySelector('[data-copy-label]');
        const copyText = copyLabel.textContent;

        root.querySelector('[data-generate]').addEventListener('click', () => {
            const password = generate(parseInt(root.dataset.length, 10));
            for (const field of [first, second]) {
                field.value = password;
                // the old "too weak" error no longer applies
                field.classList.remove('is-invalid');
                field.closest('.mb-3, .field')?.querySelectorAll('.invalid-feedback, .form-error').forEach((error) => error.remove());
            }
            value.value = password;
            result.hidden = false;
            copyLabel.textContent = copyText;
        });

        root.querySelector('[data-copy]').addEventListener('click', async (event) => {
            try {
                await navigator.clipboard.writeText(value.value);
            } catch (e) {
                value.select();
                document.execCommand('copy');
            }
            copyLabel.textContent = event.currentTarget.dataset.copiedLabel;
        });
    })();
</script>
